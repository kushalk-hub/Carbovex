# Environment for local development against MongoDB.
#
# Copy to .env and edit. Nothing here is read by the code directly — src/config/env.js
# is the single place that interprets these, so a missing or dangerous value fails
# once at boot with a readable message instead of as a 500 three hours later.
#
# There is no .env in version control and there should never be one. In production
# these come from the platform's secret store.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# How many reverse proxies sit in front of the app. This is the number that decides
# whether req.ip is trustworthy, and therefore whether the rate limiter can be
# bypassed with a forged X-Forwarded-For. Count them: one nginx in front of the app
# is 1. Setting this to a non-zero value on a directly exposed app is how you end up
# rate limiting everyone as 0.0.0.0.
TRUST_PROXY_HOPS=0

# Signs session JWTs. The dev fallback is checked at boot and rejected when
# NODE_ENV=production, so a missing JWT_SECRET can never silently ship.
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Comma-separated list, or * for any origin. Named origins rather than * because
# the API sends credentials and browsers refuse that combination.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Socket.IO. Both default to localhost so a forgotten value cannot expose the
# realtime stream to the network.
SOCKET_CORS_ORIGIN=http://localhost:5173
SOCKET_BIND_ADDRESS=127.0.0.1

# Rate limits. ingestMax applies to the sensor endpoint only, because a gateway
# posting for several sensors legitimately sends more than a human browsing does.
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
INGEST_RATE_LIMIT_MAX=120

# --------------------------------------------------------------------------------------
# MongoDB
# --------------------------------------------------------------------------------------
# The application connects with MONGO_URI. The discrete DB_* values below are the
# inputs used to *build* that URI when MONGO_URI is not set, plus the identity
# setup.js provisions. Setting both is fine; MONGO_URI wins.
#
# MONGO_URI must be a replica set (or a mongos). The trading, credit and compliance
# paths use multi-document transactions, and on a standalone mongod they fail with:
#   "Transaction numbers are only allowed on a replica set member or mongos"
# `npm run mongo:test-rs` starts a throwaway keyfile-enabled replica set on 27018,
# which is the quickest way to get one.
#
# replicaSet=rs0 matters: without it the driver may connect to a secondary, and
# transactions fail with "not primary". The keyFile is on the server, not in this
# file — see the note on the keyfile below.
MONGO_URI=mongodb://carbonx_app:carbonx_app@localhost:27018/carbonx?replicaSet=rs0&authSource=admin

DB_HOST=localhost
DB_PORT=27018
DB_NAME=carbonx

# The least-privilege role setup.js creates. Note what this user cannot do: it has no
# update/remove on the ledger, readings, audit trail, trades, payments or
# verifications, and no dropDatabase. That is the append-only guarantee — the
# model-level guards stop this application, and this grant stops everything else.
# `npm run db:verify-append-only` proves it rather than assuming it.
DB_USER=carbonx_app
DB_PASSWORD=carbonx_app

# An administrative user, used only by scripts/setup.js and the integration tests.
# It needs createRole/createUser because a user cannot grant rights it does not
# itself hold. Keep it out of the application process entirely.
#
# Do NOT point this at the 27017 service. That is a standalone instance and it
# cannot run this application at all; `npm run db:setup` will refuse and say so.
MONGO_ADMIN_URI=mongodb://carbonx_root:carbonx_root@localhost:27018/?authSource=admin&replicaSet=rs0
DB_ADMIN_USER=carbonx_root
DB_ADMIN_PASSWORD=carbonx_root

# A replica set with authorization enabled requires a keyfile, and mongod refuses to
# start without one:
#   "BadValue: security.keyFile is required when authorization is enabled with replica sets"
# A keyfile also enables internal authentication between members, so a single-node
# set still needs one. scripts/mongoTestReplicaSet.js generates it inside its own
# data directory; it is deliberately not a setting here, because a key committed
# alongside the URI is a key the URI no longer protects.
#
# Note that a keyfile is mutual authentication, not access control. It does not by
# itself require clients to present credentials — the localhost exception means an
# unauthenticated client can bootstrap the first user on an empty data directory.
# Once a user exists, that exception ends. That transition is the single most
# confusing part of the local setup, so scripts/mongoTestReplicaSet.js prints what
# state it left the server in.
DB_REPLICA_SET=rs0

# Change streams drive cross-process realtime events (market updates, alerts). They
# need a replica set and collection-level `find` + `changeStream` grants on trades,
# emissionreadings, alerts, and marketorders. `db:setup` provisions those grants;
# `auto` probes at boot and falls back to in-process emits if streams are unavailable.
MONGO_CHANGE_STREAMS=auto

# Pool sizing. maxPoolSize=20 is per application instance, not per machine, so
# several instances each get their own pool against the same server.
MONGO_POOL_MAX=20
MONGO_POOL_MIN=2
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_IDLE_TIMEOUT_MS=30000

# --------------------------------------------------------------------------------------
# Jobs
# --------------------------------------------------------------------------------------
# The scheduler runs these on an interval. Each is idempotent by design, so a missed
# tick is harmless and a double-fired tick is too.
DAILY_PRICE_CRON=02:00
EXPIRE_CREDITS_CRON=03:00
ALERT_SCAN_CRON=*/15 * * * *
# Simulated sensor traffic, for local development only. Never enable in production:
# it writes fabricated readings into the real ledger.
SENSOR_SIM_ENABLED=false
SENSOR_SIM_INTERVAL_MS=10000
